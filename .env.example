# ─── Required — generate real values before running ───────────────────────────
# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-strong-random-password
REDIS_PASSWORD=replace-with-strong-random-password
# Generate: openssl rand -hex 32
JWT_SECRET=replace-with-strong-random-secret-min-32-chars

# ─── Database (async PostgreSQL) ───────────────────────────────────────────────
# Docker path   : leave commented — docker-compose.yml injects the correct host (postgres:5432)
# No-Docker path: uncomment and ensure POSTGRES_PASSWORD is set above
# DATABASE_URL=postgresql+asyncpg://cortex:${POSTGRES_PASSWORD}@localhost:5432/cortex

# ─── Redis ─────────────────────────────────────────────────────────────────────
# Docker path   : leave commented — docker-compose.yml injects the correct host (redis:6379)
# No-Docker path: uncomment and ensure REDIS_PASSWORD is set above
# REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# ─── Ollama (local LLM, free) ──────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ─── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# ─── Observability ─────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 16
# Leave empty to disable metrics auth (not recommended for production)
METRICS_TOKEN=replace-with-strong-random-token

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * only for fully-public APIs with no auth cookies.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
